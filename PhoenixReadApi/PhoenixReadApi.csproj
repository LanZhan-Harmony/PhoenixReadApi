<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PhoenixReadApi</PackageId>
    <Version>1.0.0</Version>
    <Authors>LanZhan-Harmony</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/LanZhan-Harmony/PhoenixReadApi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LanZhan-Harmony/PhoenixReadApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>phoenix;read;hongguo;short-drama;api;nativeaot;红果;短剧</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>使用 C# 编写的 PhoenixRead 红果免费短剧 API</Description>
    <PackageReleaseNotes>首个剧库、搜索、播放和弹幕客户端版本。</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhoenixReadApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
